# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# ...salvo la plantilla, que no lleva secretos y hace falta para montar
# un servidor nuevo (.env.local sí queda fuera del repositorio).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor native builds (regenerate with: npx cap add android/ios)
/android/
/ios/

# certificate/private key bundle - never commit
/camareroporfavor

# local Claude Code tooling config
/.claude/

# unrelated nested tool repo, not part of this app
/superpowers/

# runtime error capture (instrumentation.ts)
/logs/

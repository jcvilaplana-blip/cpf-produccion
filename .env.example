# =============================================================================
# Plantilla de variables de entorno de CamareroPorFavor.
#
# `.env.local` está en .gitignore (contiene secretos) y por tanto NO viaja con
# el repositorio: al montar un servidor nuevo hay que crearlo a mano copiando
# este fichero. `scripts/preflight.mjs` aborta el build si falta alguna de las
# marcadas como OBLIGATORIA, para que nunca se despliegue una app a medias.
#
#   cp .env.example .env.local   &&   rellenar valores
# =============================================================================

# --- Supabase — OBLIGATORIAS -------------------------------------------------
# Sin estas la app no arranca: son la base de datos, la autenticación y el
# almacenamiento de imágenes y vídeos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Usada por las rutas de API con permisos elevados (subidas, perfiles públicos,
# valoraciones, gamificación). Es un secreto: nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Alternativa moderna a ANON_KEY. Si se rellena, sirve de reserva.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- URL pública — OBLIGATORIA ----------------------------------------------
# Base de los enlaces de confirmación de correo y de las redirecciones de pago.
# Al migrar de dominio hay que cambiarla aquí Y en capacitor.config.ts.
NEXT_PUBLIC_APP_URL=

# --- Correo transaccional (Resend) ------------------------------------------
# Sin esto no salen los correos de verificación ni de recuperación de contraseña.
RESEND_API_KEY=
EMAIL_FROM=

# --- Mapas (Mapbox) ----------------------------------------------------------
# Necesarias para /map y /businesses/map.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_TOKEN=

# --- Pagos: Stripe -----------------------------------------------------------
STRIPE_SECRET_KEY=
# Firma de /api/webhooks/stripe. Sin ella el webhook rechaza los eventos.
STRIPE_WEBHOOK_SECRET=

# --- Pagos: Redsys -----------------------------------------------------------
# OJO: el código las lee (lib/redsys.ts, /api/payments/redsys/*) pero en el
# servidor de desarrollo no están definidas, así que Redsys no funciona ahí.
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=
REDSYS_SECRET_KEY=
# "test" o "production"
REDSYS_ENVIRONMENT=

# --- Notificaciones push (Firebase) -----------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Utilidades --------------------------------------------------------------
# Solo la usa scripts/reset-admin-password.ts, puntualmente.
NEW_ADMIN_PASSWORD=
